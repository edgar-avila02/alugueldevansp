---
import '../styles/global.css';
import site from '../data/site.json';
import { getButtonHrefForPage } from '../lib/whatsapp-links.js';

interface Props {
  page: {
    title: string;
    description?: string;
    robots?: string;
    canonical?: string | null;
    og?: ([string, string] | string[])[];
    twitter?: ([string, string] | string[])[];
    jsonld?: string[];
    path: string;
    [key: string]: any;
  };
}

const { page } = Astro.props;
const path = page.path;
const floatingButtonHref = getButtonHrefForPage(path);
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const GTM = 'GTM-5B26SFDP';
const GA = 'GT-5D4TQKHM';
const SMARTLOOK = 'cdb7af192602f715a74697a72011cce673c46396';
const jsonld = page.jsonld ?? [];
const WHATS_PHONE = '11975413120';
---
<!doctype html>
<html lang="pt-BR" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title>
    {page.description && <meta name="description" content={page.description} />}
    {page.robots && <meta name="robots" content={page.robots} />}
    {page.canonical && <link rel="canonical" href={page.canonical} />}
    {page.og?.map(([k, v]) => <meta property={k} content={v} />)}
    {page.twitter?.map(([k, v]) => <meta name={k} content={v} />)}
    {jsonld.map((j: string) => <script type="application/ld+json" class="rank-math-schema" set:html={j} />)}
    {site.icons.map((i) => <link rel={i.rel} href={i.href} sizes={i.sizes ?? undefined} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700;800&display=swap"
    />
    <meta name="generator" content="Astro" />
    <meta name="generator" content="Site Kit by Google 1.188.0" />
    {page.googleSiteVerification && <meta name="google-site-verification" content={page.googleSiteVerification} />}

    <!-- Google Tag (gtag.js) / Google Analytics -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA}`}></script>
    <script is:inline define:vars={{ GA }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('set', 'linker', { domains: ['alugueldevansp.com'] });
      gtag('js', new Date());
      gtag('set', 'developer_id.dZTNiMT', true);
      gtag('config', GA, { googlesitekit_post_type: 'page' });
    </script>

    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ GTM }}>
      window.dataLayer = window.dataLayer || [];
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', GTM);
    </script>
    <!-- End Google Tag Manager -->

    <!-- Smartlook -->
    <script is:inline define:vars={{ SMARTLOOK }}>
      window.smartlook ||
        (function (d) {
          var o = (window.smartlook = function () {
              o.api.push(arguments);
            }),
            h = d.getElementsByTagName('head')[0];
          var c = d.createElement('script');
          o.api = new Array();
          c.async = true;
          c.type = 'text/javascript';
          c.charset = 'utf-8';
          c.src = 'https://web-sdk.smartlook.com/recorder.js';
          h.appendChild(c);
        })(document);
      smartlook('init', SMARTLOOK, { region: 'eu' });
    </script>
    <!-- End Smartlook -->
  </head>
  <body class={page.path === '/' ? 'is-home' : 'is-inner'}>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM}`} height="0" width="0" style="display:none;visibility:hidden" title="gtm"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip-link" href="#content">Pular para o conteúdo</a>

    <header class="site-header" id="masthead">
      <div class="header-inner">
        <a class="brand" href="/" rel="home" aria-label="aluguel de van sp - página inicial">
          <img src={site.logo} alt="aluguel de van sp" width="512" height="307" fetchpriority="high" />
        </a>
        <nav class="main-nav" id="site-navigation" aria-label="Principal">
          <ul>
            {site.nav.map((i) => (
              <li><a href={i.href} aria-current={isActive(i.href) ? 'page' : undefined}>{i.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="btn btn-sm btn-chamativo header-cta" href={site.ctaHref} rel="nofollow">{site.ctaLabel}</a>
        <button class="menu-toggle" aria-controls="site-navigation" aria-expanded="false" aria-label="Abrir menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <div id="content">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="footer-wave" aria-hidden="true"></div>
      <div class="footer-inner">
        <div class="footer-brand">
          <p class="footer-title">Aluguel de Van SP</p>
          <p>Aluguel de Van SP está localizado em São Paulo e atende toda a cidade. Contate-nos para agendar um orçamento gratuito.</p>
          <div class="social" aria-label="Redes sociais">
            <a href="https://www.facebook.com/profile.php?id=61573785856612" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg></a>
            <a href="https://www.instagram.com/alugueldevansp_oficial?igsh=aXR3ZnlmcTc4dWF0&utm_source=qr" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm5 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5zM17.2 6a1 1 0 1 1-1 1 1 1 0 0 1 1-1z"/></svg></a>
            <a href="https://www.youtube.com/@AlugueldeVanSP" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.8 15.1V8.9l5.4 3.1z"/></svg></a>
            <a href="https://www.pinterest.com/alugueldevansp/" rel="noopener" aria-label="Pinterest"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.5 2.1-.8 3.3-.2 1 .5 1.800 1.500 1.800 1.800 0 3.200-1.900 3.200-4.700 0-2.400-1.800-4.200-4.300-4.200a4.500 4.500 0 0 0-4.700 4.500c0 .9.3 1.800.8 2.300.1.100.1.200.1.300l-.3 1.100c0 .2-.1.200-.3.100-1.300-.6-2.100-2.500-2.100-4 0-3.300 2.400-6.300 6.900-6.300 3.600 0 6.400 2.600 6.400 6 0 3.600-2.300 6.500-5.400 6.500-1.100 0-2.100-.6-2.400-1.200l-.7 2.500a9 9 0 0 1-1 2.100A10 10 0 1 0 12 2z"/></svg></a>
            <a href="https://www.reddit.com/user/Alugueldevansp/" rel="noopener" aria-label="Reddit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12.1a2.2 2.2 0 0 0-3.7-1.6 10.800 10.800 0 0 0-5.800-1.800l1-4.600 3.200.7a1.600 1.600 0 1 0 .2-1l-3.700-.8a.5.500 0 0 0-.6.4l-1.100 5.300a10.900 10.900 0 0 0-5.900 1.800A2.200 2.200 0 1 0 4.700 14a4 4 0 0 0 0 .6c0 3 3.500 5.400 7.800 5.400s7.800-2.400 7.800-5.400a4 4 0 0 0 0-.6 2.200 2.200 0 0 0 1.700-1.900zM8 13.600a1.500 1.500 0 1 1 1.500 1.500A1.500 1.500 0 0 1 8 13.600zm8.200 3.900a5.300 5.300 0 0 1-4.200 1.200 5.300 5.300 0 0 1-4.200-1.200.4.400 0 0 1 .6-.6 4.500 4.500 0 0 0 3.600 1 4.500 4.500 0 0 0 3.600-1 .4.400 0 0 1 .6.6zm-.2-2.400a1.500 1.500 0 1 1 1.500-1.500 1.500 1.500 0 0 1-1.500 1.500z"/></svg></a>
          </div>
        </div>
        <div class="footer-col">
          <h2>Local</h2>
          <p>Av. Magalhães de Castro, 12.000 - Cidade Jardim, São Paulo - SP, 05502-001</p>
        </div>
        <div class="footer-col">
          <h2>Atendimento</h2>
          <p>24 horas</p>
          <p><a href="tel:+5511975413120">11 97541-3120</a></p>
          <p><a href="mailto:contato@alugueldevansp.com">contato@alugueldevansp.com</a></p>
        </div>
        <div class="footer-col">
          <h2>Links</h2>
          <p><a href="/">Início</a></p>
          <p><a href="/politica-de-privacidade-de-dados/">Privacidade de dados</a></p>
          <p><a href="/termos-de-servicos/">Termos de serviços</a></p>
        </div>
      </div>
      <div class="footer-bottom">
        <p>Aluguel de Vans SP © {new Date().getFullYear()} | Todos os Direitos Reservados</p>
        <img src="/wp-content/uploads/2022/01/Cadeado-do-certificado-SSL.webp" alt="Cadeado do certificado SSL" width="198" height="254" loading="lazy" />
      </div>
    </footer>

    <script is:inline>
      // Menu mobile
      (function () {
        var btn = document.querySelector('.menu-toggle');
        var header = document.getElementById('masthead');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var open = header.classList.toggle('nav-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      })();

      // Formulário de lead -> Cloudflare Pages Function (/api/lead)
      document.addEventListener('submit', async function (e) {
        var form = e.target.closest && e.target.closest('form[data-lead]');
        if (!form) return;
        e.preventDefault();
        var status = form.querySelector('.lead-status');
        var btn = form.querySelector('button[type=submit]');
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        var data = Object.fromEntries(new FormData(form).entries());
        data.pagina = location.pathname;
        btn.disabled = true;
        status.className = 'lead-status';
        status.textContent = 'Enviando…';
        try {
          var res = await fetch('/api/lead', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(data),
          });
          if (!res.ok) throw new Error('falha');
          status.textContent = 'Recebemos sua solicitação! Em breve entraremos em contato.';
          status.classList.add('ok');
          form.reset();
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'generate_lead', form_page: location.pathname });
          if (window.gtag) window.gtag('event', 'generate_lead', { page_path: location.pathname });
        } catch (err) {
          status.textContent = 'Não foi possível enviar agora. Tente novamente ou ligue para (11) 97541-3120.';
          status.classList.add('err');
        } finally {
          btn.disabled = false;
        }
      });

      // Carrossel de imagens das vans
      document.querySelectorAll('[role="region"][aria-roledescription="carousel"]').forEach(function (car) {
        var slides = car.querySelectorAll('[role="group"][aria-roledescription="slide"]');
        var buttons = car.querySelectorAll('[role="button"]');
        if (slides.length <= 1) {
          car.classList.add('is-single-slide');
          buttons.forEach(function (b) { b.style.display = 'none'; });
          return;
        }
        if (buttons.length >= 2) {
          buttons[0].classList.add('carousel-btn-prev');
          buttons[1].classList.add('carousel-btn-next');
          buttons[0].setAttribute('aria-label', 'Imagem anterior');
          buttons[1].setAttribute('aria-label', 'Próxima imagem');
        }
        var idx = 0;
        function show(i) {
          idx = (i + slides.length) % slides.length;
          slides.forEach(function (s, sIdx) {
            s.style.display = sIdx === idx ? 'block' : 'none';
            if (sIdx === idx) s.classList.add('is-active');
            else s.classList.remove('is-active');
          });
        }
        show(0);
        if (buttons.length >= 2) {
          buttons[0].addEventListener('click', function (e) { e.preventDefault(); show(idx - 1); });
          buttons[1].addEventListener('click', function (e) { e.preventDefault(); show(idx + 1); });
        }
        setInterval(function () { show(idx + 1); }, 4500);
      });
    </script>

    <!-- Botão flutuante WhatsApp / Solicitar Orçamento -->
    <a
      href={floatingButtonHref}
      target="_blank"
      rel="noopener noreferrer"
      class="sticky-cta btn-chamativo"
      aria-label="Solicitar orçamento no WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <span>Solicitar orçamento</span>
    </a>
  </body>
</html>
