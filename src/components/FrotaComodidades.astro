---
interface Props {
  variant?: 'banner' | 'compact' | 'chips-only';
  theme?: 'light' | 'dark';
  title?: string;
  subtitle?: string;
}

const {
  variant = 'banner',
  theme = 'light',
  title = 'Itens de Série em Toda a Frota',
  subtitle = 'Conforto e conectividade inclusos em todas as viagens sem custo adicional'
} = Astro.props;

const comodidades = [
  {
    id: 'ar',
    label: 'Ar-condicionado',
    sub: 'Climatização Dupla',
    // SVG Floco de Neve / Climatização
    svg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07l14.14-14.14M8 4l4 4 4-4M8 20l4-4 4-4M4 8l4 4-4 4M20 8l-4 4 4 4"/></svg>`
  },
  {
    id: 'wifi',
    label: 'Wi-Fi 4G/5G',
    sub: 'Conexão a Bordo',
    // SVG Wi-Fi
    svg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/></svg>`
  },
  {
    id: 'tv',
    label: 'TV Digital',
    sub: 'Telas Multimídia',
    // SVG Monitor / TV
    svg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>`
  },
  {
    id: 'usb',
    label: 'Tomadas USB',
    sub: 'Carga por Assento',
    // SVG Carregador / Raio / USB
    svg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`
  },
  {
    id: 'bluetooth',
    label: 'Bluetooth',
    sub: 'Som Integrado',
    // SVG Bluetooth
    svg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6.5 6.5 17.5 17.5 12 23 12 1 17.5 6.5 6.5 17.5"/></svg>`
  }
];
---

{variant === 'banner' && (
  <section class={`comodidades-section ${theme === 'light' ? 'section-light' : 'section-dark'}`}>
    <div class="comodidades-container">
      <div class={`comodidades-banner comodidades-banner--${theme}`}>
        <div class="comodidades-header">
          <span class="comodidades-kicker">Tecnologia & Bem-Estar</span>
          <h2 class="comodidades-title">{title}</h2>
          <p class="comodidades-sub">{subtitle}</p>
        </div>

        <div class="comodidades-grid">
          {comodidades.map((item) => (
            <div class="comodidade-card" data-feature={item.id}>
              <div class="comodidade-icon" set:html={item.svg} />
              <div class="comodidade-info">
                <span class="comodidade-label">{item.label}</span>
                <span class="comodidade-sub">{item.sub}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

{variant === 'compact' && (
  <div class="comodidades-chips-row" aria-label="Comodidades da Van">
    {comodidades.map((item) => (
      <span class="comodidade-chip" title={item.label}>
        <span class="chip-svg" set:html={item.svg} />
        <span class="chip-text">{item.label}</span>
      </span>
    ))}
  </div>
)}

{variant === 'chips-only' && (
  <div class="comodidades-pills-inline" aria-label="Comodidades inclusas">
    {comodidades.map((item) => (
      <span class="pill-inline-badge">
        <span class="pill-icon" set:html={item.svg} />
        {item.label}
      </span>
    ))}
  </div>
)}

<style>
  /* ==========================================================================
     MODO BANNER COMPLETO
     ========================================================================== */
  .comodidades-section {
    padding: 4.5rem 1.25rem;
  }

  .comodidades-section.section-light {
    background: #ffffff;
    box-shadow: 0 0 0 100vmax #ffffff;
    clip-path: inset(0 -100vmax);
  }

  .comodidades-section.section-dark {
    background: #0f1a10;
    box-shadow: 0 0 0 100vmax #0f1a10;
    clip-path: inset(0 -100vmax);
  }

  .comodidades-container {
    max-width: 1140px;
    margin: 0 auto;
  }

  .comodidades-banner {
    border-radius: 20px;
    padding: 2.75rem 2.25rem;
  }

  .comodidades-banner--dark {
    background: linear-gradient(135deg, #0f1a10 0%, #172a1a 100%);
    border: 1px solid rgba(252, 192, 68, 0.25);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    color: #ffffff;
  }

  .comodidades-banner--light {
    background: #fdfdfc;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
    color: #0f172a;
  }

  .comodidades-banner--light .comodidades-title {
    color: #0f172a;
  }

  .comodidades-banner--light .comodidades-sub {
    color: #475569;
  }

  .comodidades-banner--light .comodidade-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .comodidades-banner--light .comodidade-card:hover {
    background: #ffffff;
    border-color: #2e7d32;
    box-shadow: 0 8px 20px rgba(46, 125, 50, 0.12);
  }

  .comodidades-banner--light .comodidade-label {
    color: #0f172a;
  }

  .comodidades-banner--light .comodidade-sub {
    color: #64748b;
  }

  .comodidades-banner--light .comodidade-icon {
    background: rgba(46, 125, 50, 0.1);
    color: #2e7d32;
  }

  .comodidades-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2.25rem;
  }

  .comodidades-kicker {
    display: inline-block;
    color: #b45309;
    background: rgba(252, 192, 68, 0.18);
    border: 1px solid rgba(252, 192, 68, 0.4);
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.6rem;
  }

  .comodidades-banner--dark .comodidades-kicker {
    color: #fcc044;
    background: rgba(252, 192, 68, 0.12);
  }

  .comodidades-title {
    font-family: inherit;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.5rem;
    line-height: 1.25;
  }

  .comodidades-sub {
    font-size: 1rem;
    color: #cbd5e1;
    margin: 0;
    line-height: 1.5;
  }

  .comodidades-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1.15rem;
  }

  .comodidade-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 1rem 1.15rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .comodidade-card:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(252, 192, 68, 0.4);
  }

  .comodidade-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(91, 154, 66, 0.2);
    color: #4ade80;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .comodidade-info {
    display: flex;
    flex-direction: column;
  }

  .comodidade-label {
    font-size: 0.96rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
  }

  .comodidade-sub {
    font-size: 0.78rem;
    color: #94a3b8;
    margin-top: 0.15rem;
  }

  /* ==========================================================================
     MODO COMPACTO (CHIPS PARA CARDS E VITRINES DE VANS)
     ========================================================================== */
  .comodidades-chips-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin: 0.75rem 0;
  }

  .comodidade-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    padding: 0.3rem 0.65rem;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #334155;
    transition: all 0.2s ease;
  }

  .comodidade-chip:hover {
    background: #e2e8f0;
    color: #0f172a;
    border-color: #cbd5e1;
  }

  .chip-svg {
    display: flex;
    align-items: center;
    color: #166534;
  }

  .chip-text {
    line-height: 1;
  }

  /* ==========================================================================
     MODO PILLS INLINE
     ========================================================================== */
  .comodidades-pills-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }

  .pill-inline-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(91, 154, 66, 0.08);
    border: 1px solid rgba(91, 154, 66, 0.2);
    color: #166534;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .pill-icon {
    display: flex;
    align-items: center;
    color: #15803d;
  }

  @media (max-width: 640px) {
    .comodidades-banner {
      padding: 1.75rem 1.25rem;
    }
    .comodidades-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
