---
interface Props {
  buttonHref?: string;
  badgeTitle?: string;
  title?: string;
  subtitle?: string;
}

const {
  buttonHref = "https://alugueldevansp.com/aluguel-de-van-12-lugares-1",
  badgeTitle = "Shows, Festivais e Turismo",
  title = "Vans Executivas para Megaeventos e Excursões em SP",
  subtitle = "Transporte de ida e volta planejado para você não se preocupar com trânsito, estacionamentos abusivos ou motorista da rodada."
} = Astro.props;

const eventos = [
  {
    tag: "Festival & Música",
    tagColor: "gold",
    title: "Transporte para o Lollapalooza Brasil",
    location: "Autódromo de Interlagos · SP",
    desc: "Esqueça o aperto no trem e as tarifas dinâmicas de aplicativo na saída. Tenha uma van exclusiva com ponto de encontro estratégico, ar-condicionado e embarque prioritário para seu grupo.",
    icon: "music"
  },
  {
    tag: "Motorsport VIP",
    tagColor: "blue",
    title: "Vans para a Fórmula 1 em Interlagos",
    location: "GP São Paulo · Interlagos",
    desc: "Pontualidade britânica para chegar antes da luz verde. Nossos motoristas dominam as rotas liberadas e desvios operacionais da CET para acesso mais ágil aos portões.",
    icon: "flag"
  },
  {
    tag: "Viagem Interestadual",
    tagColor: "purple",
    title: "Excursão de Van para o Rock in Rio",
    location: "Cidade do Rock · Rio de Janeiro",
    desc: "Bate-volta ou estadia com total conforto na Dutra. Poltronas semi-leito reclináveis, tomadas USB individuais, TV digital e amplo bagageiro para as malas da galera.",
    icon: "globe"
  },
  {
    tag: "Megaevento SP",
    tagColor: "amber",
    title: "Translado e Vans para The Town",
    location: "Cidade da Música · Interlagos",
    desc: "A melhor logística para os palcos de São Paulo. Retorno noturno com segurança total e sem espera na chuva: o motorista aguarda o término do show para levar todos para casa.",
    icon: "stage"
  },
  {
    tag: "Fé & Conforto",
    tagColor: "emerald",
    title: "Turismo Religioso para Aparecida do Norte",
    location: "Santuário Nacional e Rota da Fé",
    desc: "Translados acolhedores e tranquilos para romarias, paróquias e famílias. Veículos suaves com acessibilidade, espaço para idosos e bagageiro grande para artigos religiosos.",
    icon: "faith"
  },
  {
    tag: "Lazer em Família",
    tagColor: "rose",
    title: "Excursões para Hopi Hari e Wet'n Wild",
    location: "Rodovia dos Bandeirantes · Vinhedo",
    desc: "Diversão que começa na viagem! Conecte sua playlist no Bluetooth, aproveite o ar gelando e esqueça o cansaço ao volante depois de um dia inteiro nos brinquedos e piscinas.",
    icon: "rollercoaster"
  }
];
---

<section class="megaeventos-section" aria-label="Transporte para Megaeventos e Turismo">
  <div class="megaeventos-container">
    
    <!-- Cabeçalho com H2 para Hierarquia SEO Perfeita -->
    <header class="megaeventos-header">
      <div class="megaeventos-kicker-wrap">
        <span class="megaeventos-icon-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        </span>
        <span class="megaeventos-kicker">{badgeTitle}</span>
      </div>

      <h2 class="megaeventos-title">{title}</h2>
      <p class="megaeventos-subtitle">{subtitle}</p>
    </header>

    <!-- Grid dos 6 Cards Semânticos H3 -->
    <div class="megaeventos-grid">
      {eventos.map((ev) => (
        <article class="evento-card">
          <div class="evento-card-top">
            <span class={`evento-badge evento-badge--${ev.tagColor}`}>
              {ev.tag}
            </span>
            <span class="evento-location">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              {ev.location}
            </span>
          </div>

          <!-- Título H3 exigido para subtópicos de SEO -->
          <h3 class="evento-heading">{ev.title}</h3>

          <p class="evento-desc">{ev.desc}</p>

          <div class="evento-card-footer">
            <a
              href={buttonHref}
              class="evento-cta-link"
              title={`Reservar van para ${ev.title}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Orçar para este evento</span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Banner Inferior de Conversão Direta com Benefícios Rápido -->
    <div class="megaeventos-bottom-cta">
      <div class="bottom-cta-content">
        <div class="bottom-cta-text">
          <span class="bottom-cta-badge">Reserva Antecipada Recomendada</span>
          <strong class="bottom-cta-headline">Vai reunir a galera para um grande evento?</strong>
          <p class="bottom-cta-sub">
            Garanta seu veículo com antecedência e evite a indisponibilidade de frota nas datas mais concorridas do calendário de São Paulo.
          </p>
        </div>

        <div class="bottom-cta-action">
          <a
            href={buttonHref}
            class="megaeventos-btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            <!-- WhatsApp Icon SVG -->
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.586 1.771.889 2.796.889h.005c3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.776-5.773-5.776zm3.391 8.163c-.144.405-.837.774-1.17.822-.311.045-.694.06-2.18-.556-1.9-1.026-3.136-2.96-3.232-3.088-.095-.127-.775-1.031-.775-1.965 0-.935.489-1.393.664-1.583.175-.19.382-.238.51-.238.127 0 .255.002.366.007.118.005.276-.045.431.328.16.386.545 1.332.593 1.429.048.097.08.21.016.338-.064.127-.096.206-.19.317-.096.111-.202.248-.289.333-.095.095-.195.198-.084.388.111.19.493.813 1.059 1.317.728.647 1.342.848 1.533.943.19.095.302.079.413-.048.111-.127.477-.556.604-.746.127-.19.254-.159.429-.095.175.064 1.112.524 1.303.62.19.095.318.143.366.222.048.079.048.46-.096.865z"/>
            </svg>
            <span>Consultar Data do Meu Evento</span>
          </a>
          <span class="cta-guarantee-note">
            ✓ Frota com seguro APP e registros EMTU / ANTT
          </span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .megaeventos-section {
    padding: 4.5rem 1.25rem;
    background: linear-gradient(180deg, #0d160e 0%, #122115 50%, #0d160e 100%);
    color: #f1f5f9;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
  }

  .megaeventos-section::before {
    content: '';
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(circle, rgba(252, 192, 68, 0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .megaeventos-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Header */
  .megaeventos-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3rem auto;
  }

  .megaeventos-kicker-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(252, 192, 68, 0.12);
    border: 1px solid rgba(252, 192, 68, 0.35);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .megaeventos-icon-badge {
    color: #fcc044;
    display: flex;
    align-items: center;
  }

  .megaeventos-kicker {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fcc044;
  }

  .megaeventos-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  .megaeventos-subtitle {
    font-size: 1.0625rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin: 0;
  }

  /* Grid */
  .megaeventos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  /* Card */
  .evento-card {
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    backdrop-filter: blur(8px);
  }

  .evento-card:hover {
    transform: translateY(-4px);
    border-color: rgba(252, 192, 68, 0.4);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    background: rgba(255, 255, 255, 0.055);
  }

  .evento-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.15rem;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .evento-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
  }

  .evento-badge--gold {
    background: rgba(252, 192, 68, 0.15);
    color: #fcc044;
    border: 1px solid rgba(252, 192, 68, 0.3);
  }

  .evento-badge--blue {
    background: rgba(66, 133, 244, 0.15);
    color: #70a7ff;
    border: 1px solid rgba(66, 133, 244, 0.3);
  }

  .evento-badge--purple {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .evento-badge--amber {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .evento-badge--emerald {
    background: rgba(52, 211, 153, 0.15);
    color: #6ee7b7;
    border: 1px solid rgba(52, 211, 153, 0.3);
  }

  .evento-badge--rose {
    background: rgba(244, 63, 94, 0.15);
    color: #fda4af;
    border: 1px solid rgba(244, 63, 94, 0.3);
  }

  .evento-location {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .evento-location svg {
    color: #94a3b8;
  }

  .evento-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.35;
    margin: 0 0 0.85rem 0;
  }

  .evento-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  .evento-card-footer {
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .evento-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #fcc044;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .evento-cta-link:hover {
    color: #ffd875;
    transform: translateX(3px);
  }

  /* Bottom CTA Box */
  .megaeventos-bottom-cta {
    background: linear-gradient(135deg, rgba(23, 42, 26, 0.8) 0%, rgba(13, 22, 14, 0.95) 100%);
    border: 1px solid rgba(252, 192, 68, 0.3);
    border-radius: 20px;
    padding: 2.25rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    position: relative;
    overflow: hidden;
  }

  .megaeventos-bottom-cta::before {
    content: '';
    position: absolute;
    right: -50px;
    bottom: -50px;
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(46, 125, 50, 0.25) 0%, transparent 70%);
    pointer-events: none;
  }

  .bottom-cta-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 860px) {
    .bottom-cta-content {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2.5rem;
    }
  }

  .bottom-cta-text {
    flex: 1;
  }

  .bottom-cta-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fcc044;
    background: rgba(252, 192, 68, 0.15);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }

  .bottom-cta-headline {
    display: block;
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .bottom-cta-sub {
    font-size: 0.9375rem;
    color: #cbd5e1;
    line-height: 1.5;
    margin: 0;
  }

  .bottom-cta-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  @media (min-width: 860px) {
    .bottom-cta-action {
      align-items: flex-end;
    }
  }

  .megaeventos-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: #25d366;
    color: #0c1a0e;
    font-size: 1rem;
    font-weight: 800;
    padding: 0.95rem 1.6rem;
    border-radius: 12px;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(37, 211, 102, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .megaeventos-btn-primary:hover {
    background: #2ee672;
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(37, 211, 102, 0.45);
  }

  .cta-guarantee-note {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  @media (max-width: 640px) {
    .megaeventos-section {
      padding: 3rem 1rem;
    }
    .megaeventos-grid {
      grid-template-columns: 1fr;
    }
    .megaeventos-bottom-cta {
      padding: 1.5rem;
    }
    .megaeventos-btn-primary {
      width: 100%;
      justify-content: center;
    }
    .bottom-cta-action {
      width: 100%;
      align-items: stretch;
    }
    .cta-guarantee-note {
      text-align: center;
    }
  }
</style>
