---
import Base from '../layouts/Base.astro';
import FrotaComodidades from './FrotaComodidades.astro';
import GoogleReviewsSection from './GoogleReviewsSection.astro';
import MegaEventosSection from './MegaEventosSection.astro';
import { injectForm } from '../lib/pages.js';
import { getButtonHrefForPage } from '../lib/whatsapp-links.js';
import * as cheerio from 'cheerio';

interface Props {
  page: any;
}

const { page } = Astro.props;
const pagePath = page.path || '';

// 1. Link do WhatsApp oficial específico para a página (preservando o mapeamento individual)
const is12Lugares = pagePath.includes('12-lugares');
const whatsappLink = is12Lugares
  ? 'https://alugueldevansp.com/aluguel-de-van-12-lugares-1'
  : getButtonHrefForPage(pagePath);

// 2. Processa o HTML e segmenta as seções para organização coesa e alternância rigorosa Claro/Escuro
const rawProcessedHtml = injectForm(page.html, pagePath);
const $ = cheerio.load(rawProcessedHtml, { xmlMode: false, decodeEntities: false });

// Seção 1 (ESCURO ⚫): Hero Card + Razões de Escolha isolados cirurgicamente
const heroCardHtml = $.html($('.service-hero-compare-section').first());
const reasonsHtml = $.html($('.section-service-reasons').first());
const topHtml = heroCardHtml + reasonsHtml;

// Seções opcionais específicas de modelos compactos (ex: minivans)
const economicOptionsHtml = $.html($('.section-economic-options').first());
const whenToBookHtml = $.html($('.section-service-when-to-book').first());

// Seção 6 (CLARO ⚪): Dicas da página original (preservando cidade, bairro e orientações específicas)
const tipsSection = $('.section-service-tips').first();
const hasCustomTips = tipsSection.length > 0 && tipsSection.find('.service-tip-card').length > 0;
const customTipsHtml = hasCustomTips ? tipsSection.html() : '';

// Seção 9 (ESCURO ⚫): Formulário de Lead com Contatos isolado
const leadHtml = $.html($('.section-service-lead').first());

// Configuração dinâmica dos títulos de Comodidades e MegaEventos conforme a categoria do veículo
function getComodidadesConfig(p: string) {
  const lp = p.toLowerCase();
  if (lp.includes('12-lugares')) {
    return {
      title: 'Conforto de Primeira Linha em Nossas Vans de 12 Lugares',
      subtitle: 'Itens de série revisados para garantir a melhor experiência para sua família ou equipe'
    };
  }
  if (lp.includes('15-lugares')) {
    return {
      title: 'Conforto de Primeira Linha em Nossas Vans de 15 Lugares',
      subtitle: 'Itens de série revisados para garantir a melhor experiência para sua família ou equipe'
    };
  }
  if (lp.includes('18-lugares')) {
    return {
      title: 'Conforto de Primeira Linha em Nossas Vans de 18 Lugares',
      subtitle: 'Máxima capacidade e conforto premium para grandes grupos e viagens longas'
    };
  }
  if (lp.includes('mini-van') || lp.includes('minivan')) {
    return {
      title: 'Conforto e Praticidade em Nossas Minivans',
      subtitle: 'Veículos ágeis e confortáveis para famílias e traslados rápidos em SP'
    };
  }
  if (lp.includes('carga') || lp.includes('furgao')) {
    return {
      title: 'Estrutura Completa para Transporte de Carga',
      subtitle: 'Veículos utilitários seguros e revisados para entregas, fretes e eventos'
    };
  }
  if (lp.includes('casamento')) {
    return {
      title: 'Conforto e Elegância para Transporte de Casamento',
      subtitle: 'Veículos impecáveis e pontualidade britânica para o grande dia'
    };
  }
  if (lp.includes('viagem') || lp.includes('passeio')) {
    return {
      title: 'Conforto de Primeira Linha em Nossas Vans para Viagem e Turismo',
      subtitle: 'Veículos revisados e climatizados para trajetos rodoviários, praia e interior'
    };
  }
  return {
    title: 'Conforto de Primeira Linha em Nossas Vans Executivas',
    subtitle: 'Itens de série revisados para garantir a melhor experiência para sua família ou equipe'
  };
}

function getMegaEventosConfig(p: string) {
  const lp = p.toLowerCase();
  let vehicleName = 'Vans Executivas';
  if (lp.includes('12-lugares')) vehicleName = 'Van 12 Lugares';
  else if (lp.includes('15-lugares')) vehicleName = 'Van 15 Lugares';
  else if (lp.includes('18-lugares')) vehicleName = 'Van 18 Lugares';
  else if (lp.includes('mini-van') || lp.includes('minivan')) vehicleName = 'Minivans';
  else if (lp.includes('viagem')) vehicleName = 'Vans para Viagem';

  return {
    title: `Aluguel de ${vehicleName} para Shows, Festivais e Excursões em SP`,
    subtitle: 'Reserve seu transporte para os principais eventos do ano com ida e volta garantidas, sem preocupação com trânsito ou estacionamento.'
  };
}

const comodidadesConfig = getComodidadesConfig(pagePath);
const megaEventosConfig = getMegaEventosConfig(pagePath);
---

<!-- Topo da Página: Título H1 Preservando Cidade, Bairro e Serviço -->
<header class="page-hero">
  <div class="page-hero-inner">
    <h1>{page.h1 || page.title}</h1>
  </div>
</header>

<!-- =========================================================================
     SEÇÃO 1: TOPO ORIGINAL COM CARD DA VAN + BENEFÍCIOS + RAZÕES
     FUNDO: ESCURO ⚫
     ========================================================================= -->
<div class="service-hero-top-wrapper is-service-page">
  <Fragment set:html={topHtml} />
</div>

<!-- =========================================================================
     SEÇÃO 2: COMODIDADES DA FROTA
     FUNDO: CLARO ⚪
     ========================================================================= -->
<FrotaComodidades
  variant="banner"
  theme="light"
  title={comodidadesConfig.title}
  subtitle={comodidadesConfig.subtitle}
/>

<!-- Bloco opcional de comparação econômica (se a página possuir) -->
{economicOptionsHtml && (
  <div class="section-economic-options-wrapper">
    <Fragment set:html={economicOptionsHtml} />
  </div>
)}

<!-- =========================================================================
     SEÇÃO 3: MEGAEVENTOS E TURISMO EM SP
     FUNDO: ESCURO ⚫
     ========================================================================= -->
<MegaEventosSection
  buttonHref={whatsappLink}
  title={megaEventosConfig.title}
  subtitle={megaEventosConfig.subtitle}
/>

<!-- Bloco opcional de quando reservar / sazonalidade (se a página possuir) -->
{whenToBookHtml && (
  <div class="section-when-to-book-wrapper">
    <Fragment set:html={whenToBookHtml} />
  </div>
)}

<!-- =========================================================================
     SEÇÃO 4: PROVA SOCIAL PADRÃO GOOGLE REVIEWS + ÓRGÃOS HOMOLOGADOS
     6 Avaliações amadoras autênticas + Selos EMTU, SPTrans, ANTT e Artesp
     FUNDO: CLARO ⚪
     ========================================================================= -->
<section class="section-light section-social-trust">
  <div class="social-trust-inner">
    <GoogleReviewsSection badgeTitle="Avaliações Verificadas no Google" />

    <!-- Órgãos Reguladores e Homologações Oficiais -->
    <div class="partners-block-wrap">
      <div class="partners-block text-center">
        <h3 class="partners-title">Veículos 100% regulamentados e homologados</h3>
        <p class="partners-sub">Autorizados pelos principais órgãos de fiscalização de transporte público e rodoviário:</p>
        <div class="partners-logos-row">
          <div class="partner-logo-box">
            <img src="/wp-content/uploads/2025/07/Logo-EMTU.webp" alt="Logo EMTU" width="180" height="90" loading="lazy" />
          </div>
          <div class="partner-logo-box">
            <img src="/wp-content/uploads/2025/07/Logo-SPTrans.webp" alt="Logo SPTrans" width="180" height="86" loading="lazy" />
          </div>
          <div class="partner-logo-box">
            <img src="/wp-content/uploads/2026/03/Logo-da-ANTT.webp" alt="Logo ANTT" width="180" height="94" loading="lazy" />
          </div>
          <div class="partner-logo-box">
            <img src="/wp-content/uploads/2026/03/Logo-da-Artesp.webp" alt="Logo Artesp" width="180" height="94" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     SEÇÃO 5: O QUE VOCÊ PRECISA SABER? (DIFERENCIAIS ESSENCIAIS)
     FUNDO: ESCURO ⚫
     ========================================================================= -->
<section class="section-dark section-know">
  <div class="section-dark-inner">
    <div class="section-head-dark text-center">
      <span class="kicker-gold">Informações Importantes</span>
      <h2>O que você precisa saber?</h2>
      <p class="section-sub-dark">Informações essenciais para planejar sua locação com total transparência e tranquilidade:</p>
    </div>

    <div class="know-grid">
      <div class="know-card">
        <div class="know-icon">💰</div>
        <h3>Preço justo e sem surpresas</h3>
        <p>Valores informados com antecedência, contemplando motorista, combustível e seguro dos passageiros.</p>
      </div>

      <div class="know-card">
        <div class="know-icon">🗺️</div>
        <h3>Roteiro personalizado</h3>
        <p>Você decide onde e quando quer parar. Total flexibilidade de horário e itinerário para o seu grupo.</p>
      </div>

      <div class="know-card">
        <div class="know-icon">⚡</div>
        <h3>Reserva facilitada</h3>
        <p>Envio imediato da proposta com contrato digital. Confirmação rápida e sem complicações.</p>
      </div>

      <div class="know-card">
        <div class="know-icon">👨‍✈️</div>
        <h3>Motoristas experientes</h3>
        <p>Profissionais qualificados, credenciados e experientes em viagens urbanas, serranas e interestaduais.</p>
      </div>

      <div class="know-card">
        <div class="know-icon">🚐</div>
        <h3>Frota nova e revisada</h3>
        <p>Veículos equipados com ar-condicionado de alta capacidade, poltronas reclináveis e rigorosa higienização.</p>
      </div>

      <div class="know-card">
        <div class="know-icon">⏱️</div>
        <h3>Pontualidade rigorosa</h3>
        <p>Chegamos com antecedência ao ponto de embarque para garantir que sua programação ocorra perfeitamente.</p>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     SEÇÃO 6: ORIENTAÇÕES ÚTEIS E VANTAGENS EXCLUSIVAS
     Dicas da Página (preservando localidade e veículo) + 3 Benefícios com Fotos
     FUNDO: CLARO ⚪
     ========================================================================= -->
<section class="section-light section-tips-benefits">
  <div class="tips-benefits-inner">
    {hasCustomTips ? (
      <Fragment set:html={customTipsHtml} />
    ) : (
      <div>
        <div class="section-head text-center">
          <span class="badge-pill">Orientações Úteis</span>
          <h2>As melhores dicas para alugar sua van</h2>
          <p class="section-sub">Aqui estão algumas sugestões valiosas para planejar sua viagem com total comodidade:</p>
        </div>

        <div class="service-tips-grid">
          <div class="service-tip-card">
            <div class="tip-card-header">
              <span class="tip-check">✓</span>
              <h3 class="tip-card-title">Planeje o roteiro e informe a locadora</h3>
            </div>
            <p>Se for uma viagem longa ou com paradas específicas, avise a empresa. Isso ajuda na escolha do modelo e evita cobranças extras.</p>
          </div>

          <div class="service-tip-card">
            <div class="tip-card-header">
              <span class="tip-check">✓</span>
              <h3 class="tip-card-title">Avalie o espaço para bagagens</h3>
            </div>
            <p>Se o grupo levar muitas malas, verifique se há compartimento extra ou possibilidade de rebatimento de bancos.</p>
          </div>

          <div class="service-tip-card">
            <div class="tip-card-header">
              <span class="tip-check">✓</span>
              <h3 class="tip-card-title">Reserve com antecedência</h3>
            </div>
            <p>Principalmente em feriados ou alta temporada, vans são muito procuradas. Reservar cedo garante disponibilidade e melhores preços.</p>
          </div>
        </div>
      </div>
    )}

    <!-- Bloco de Benefícios da Frota com Fotos -->
    <div class="section-benefits-divider">
      <div class="section-head text-center">
        <span class="badge-pill">Vantagens Exclusivas</span>
        <h2>Temos os melhores benefícios</h2>
        <p class="section-sub">Viajar de van combina economia, praticidade e conforto inigualável para o seu grupo.</p>
      </div>

      <div class="benefits-gallery">
        <div class="benefit-photo-card">
          <img src="/wp-content/uploads/2025/07/Pessoas-felizes-dentro-da-van-1024x683.webp" alt="Espaço interno e poltronas reclináveis" loading="lazy" />
          <div class="benefit-caption">
            <h3>Espaço e conforto premium</h3>
            <p>Poltronas reclináveis individuais, ar-condicionado duplo e som ambiente.</p>
          </div>
        </div>
        <div class="benefit-photo-card">
          <img src="/wp-content/uploads/2025/07/Jovens-ao-redor-de-uma-van-1024x683.webp" alt="Viagens e passeios em grupo" loading="lazy" />
          <div class="benefit-caption">
            <h3>União e diversão no trajeto</h3>
            <p>Todos viajam juntos sem cansaço de dirigir ou custos de pedágio em vários carros.</p>
          </div>
        </div>
        <div class="benefit-photo-card">
          <img src="/wp-content/uploads/2025/07/Van-Renault-Master-preta.webp" alt="Vans executivas" loading="lazy" />
          <div class="benefit-caption">
            <h3>Padrão executivo</h3>
            <p>Veículos discretos, elegantes e higienizados para empresas e eventos especiais.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     SEÇÃO 7: COMO ALUGAR SUA VAN EM 3 PASSOS SEM BUROCRACIA (CENTRALIZADO)
     FUNDO: ESCURO ⚫
     ========================================================================= -->
<section class="section-dark section-booking">
  <div class="steps-dark">
    <div class="steps-dark-head text-center">
      <span class="kicker-gold">Processo Simples</span>
      <h2>Como alugar sua van em 3 passos sem burocracia</h2>
    </div>

    <div class="steps-dark-grid">
      <div class="step-dark-card">
        <div class="step-circle">1</div>
        <h3>Envie seu roteiro</h3>
        <p>Informe pelo WhatsApp ou formulário: data, destino, horário e quantidade de passageiros.</p>
      </div>
      <div class="step-dark-card">
        <div class="step-circle">2</div>
        <h3>Receba a proposta</h3>
        <p>Enviamos em minutos o orçamento detalhado com o modelo de van ideal e todos os itens inclusos.</p>
      </div>
      <div class="step-dark-card">
        <div class="step-circle">3</div>
        <h3>Embarque e curta</h3>
        <p>A van chega pontualmente no endereço combinado. É só entrar, relaxar e aproveitar cada quilômetro!</p>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     SEÇÃO 8: QUANTO CUSTA O ALUGUEL DA VAN? (TABELA DE PREÇOS CENTRALIZADA)
     FUNDO: CLARO ⚪
     ========================================================================= -->
<section class="section-light section-pricing">
  <div class="pricing-inner">
    <div class="section-head text-center">
      <span class="badge-pill">Transparência de Valores</span>
      <h2>Quanto custa o aluguel da van?</h2>
      <p class="section-sub">Confira valores médios referenciais para os trajetos e destinos mais procurados:</p>
    </div>

    <div class="pricing-table-wrap">
      <table class="pricing-table">
        <thead>
          <tr>
            <th>Origem</th>
            <th>Destino</th>
            <th>Capacidade</th>
            <th>Preço médio estimado</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>São Paulo</strong></td>
            <td>Santos / Baixada Santista</td>
            <td>15 a 18 lugares</td>
            <td><span class="price-tag">A partir de R$ 680</span></td>
          </tr>
          <tr>
            <td><strong>São Paulo</strong></td>
            <td>Campinas e Região</td>
            <td>15 a 18 lugares</td>
            <td><span class="price-tag">A partir de R$ 780</span></td>
          </tr>
          <tr>
            <td><strong>São Paulo</strong></td>
            <td>Campos do Jordão / Serra</td>
            <td>15 a 18 lugares</td>
            <td><span class="price-tag">A partir de R$ 1.150</span></td>
          </tr>
          <tr>
            <td><strong>São Paulo</strong></td>
            <td>Aeroporto de Guarulhos (GRU)</td>
            <td>Minivan / Van</td>
            <td><span class="price-tag">A partir de R$ 420</span></td>
          </tr>
          <tr>
            <td><strong>São Paulo</strong></td>
            <td>Ubatuba / Litoral Norte</td>
            <td>15 a 18 lugares</td>
            <td><span class="price-tag">A partir de R$ 1.350</span></td>
          </tr>
          <tr>
            <td><strong>São Paulo</strong></td>
            <td>Aparecida do Norte</td>
            <td>15 a 18 lugares</td>
            <td><span class="price-tag">A partir de R$ 1.100</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="pricing-disclaimer">
      *Valores referenciais com base no histórico de locação. O preço final pode variar conforme quilometragem, tempo de espera, pedágios e data da viagem. Entre em contato para uma cotação exata.
    </p>

    <div class="pricing-cta-wrap text-center">
      <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn-chamativo pricing-btn">
        <span>Solicitar orçamento sob medida</span>
      </a>
    </div>
  </div>
</section>

<!-- =========================================================================
     SEÇÃO 9: PEÇA SEU ORÇAMENTO GRATUITAMENTE (FORMULÁRIO DE LEAD)
     FUNDO: ESCURO ⚫
     ========================================================================= -->
<Fragment set:html={leadHtml} />

<!-- =========================================================================
     SEÇÃO 10: CONFIRA OS VEÍCULOS DISPONÍVEIS (PARTE FINAL FIXA)
     9 Modelos com links preservados - Centralizado
     FUNDO: CLARO ⚪
     ========================================================================= -->
<section class="section-light section-fleet">
  <div class="fleet-inner">
    <div class="section-head text-center">
      <span class="badge-pill">Nossa Frota</span>
      <h2>Confira os veículos disponíveis para sua viagem</h2>
      <p class="section-sub">Selecione o modelo perfeito para as necessidades do seu grupo:</p>
    </div>

    <div class="fleet-grid">
      <div class="fleet-card">
        <a href="/aluguel-de-van-12-lugares/" class="fleet-thumb" aria-label="Van 12 lugares">
          <img src="/wp-content/uploads/2025/07/Van-de-12-lugares-branca.webp" alt="Aluguel de van 12 lugares" loading="lazy" />
        </a>
        <h3 class="fleet-title">
          <a href="/aluguel-de-van-12-lugares/">Van 12 lugares</a>
        </h3>
        <p class="fleet-desc">Perfeita para grupos médios, passeios em família e transfers com total agilidade e conforto.</p>
      </div>

      <div class="fleet-card">
        <a href="/aluguel-de-van-15-lugares/" class="fleet-thumb" aria-label="Van 15 lugares">
          <img src="/wp-content/uploads/2025/07/Van-Renault-Master-15-lugares.webp" alt="Aluguel de van 15 lugares" loading="lazy" />
        </a>
        <h3 class="fleet-title">
          <a href="/aluguel-de-van-15-lugares/">Van 15 lugares</a>
        </h3>
        <p class="fleet-desc">Espaço amplo com poltronas reclináveis para excursões, eventos e viagens com amigos.</p>
      </div>

      <div class="fleet-card">
        <a href="/aluguel-de-van-18-lugares/" class="fleet-thumb" aria-label="Van 18 lugares">
          <img src="/wp-content/uploads/2025/06/Van-Mercedes-Benz-Sprinter.webp" alt="Aluguel de van 18 lugares" loading="lazy" />
        </a>
        <h3 class="fleet-title">
          <a href="/aluguel-de-van-18-lugares/">Van 18 lugares</a>
        </h3>
        <p class="fleet-desc">Capacidade máxima para grandes grupos, convenções corporativas e turismo interestadual.</p>
      </div>

      <div class="fleet-card">
        <a href="/aluguel-de-van-com-motorista/" class="fleet-thumb" aria-label="Van com motorista">
          <img src="/wp-content/uploads/2025/07/Van-Sprinter-prata.webp" alt="Van com motorista" loading="lazy" />
        </a>
        <h3 class="fleet-title">
          <a href="/aluguel-de-van-com-motorista/">Van com motorista</a>
        </h3>
        <p class="fleet-desc">Motoristas profissionais e credenciados para você viajar com segurança e tranquilidade.</p>
      </div>

      <div class="fleet-card">
        <a href="/aluguel-de-van-para-viagem/" class="fleet-thumb" aria-label="Van para viagem">
          <img src="/wp-content/uploads/2025/07/Van-Mercedes-Benz-branca.webp" alt="Van para viagem" loading="lazy" />
        </a>
        <h3 class="fleet-title">
          <a href="/aluguel-de-van-para-viagem/">Van para viagem</a>
        </h3>
        <p class="fleet-desc">Veículos revisados e climatizados para trajetos rodoviários, praia e interior.</p>
      </div>

      <div class="fleet-card">
        <a href="/aluguel-de-van-para-passeio/" class="fleet-thumb" aria-label="Van para passeio">
          <img src="/wp-content/uploads/2025/07/Van-Grand-Starex.webp" alt="Van para passeio" loading="lazy" />
        </a>
        <h3 class="fleet-title">
          <a href="/aluguel-de-van-para-passeio/">Van para passeio</a>
        </h3>
        <p class="fleet-desc">Transporte sob medida para passeios urbanos, finais de semana e comemorações.</p>
      </div>

      <div class="fleet-card">
        <a href="/aluguel-de-mini-van/" class="fleet-thumb" aria-label="Minivan executiva">
          <img src="/wp-content/uploads/2025/07/Mercedes-Benz-Minivan-prata.webp" alt="Minivan executiva" loading="lazy" />
        </a>
        <h3 class="fleet-title">
          <a href="/aluguel-de-mini-van/">Minivan executiva</a>
        </h3>
        <p class="fleet-desc">Padrão executivo e discrição para traslados de aeroportos e reuniões corporativas.</p>
      </div>

      <div class="fleet-card">
        <a href="/aluguel-de-mini-van-7-lugares/" class="fleet-thumb" aria-label="Minivan 7 lugares">
          <img src="/wp-content/uploads/2025/07/Spin-Chevrolet-Minivan-1024x576.webp" alt="Minivan 7 lugares" loading="lazy" />
        </a>
        <h3 class="fleet-title">
          <a href="/aluguel-de-mini-van-7-lugares/">Minivan 7 lugares</a>
        </h3>
        <p class="fleet-desc">Ideal para famílias pequenas que buscam economia e comodidade no deslocamento.</p>
      </div>

      <div class="fleet-card">
        <a href="/aluguel-de-van-furgao/" class="fleet-thumb" aria-label="Van de carga / furgão">
          <img src="/wp-content/uploads/2025/07/Master-furgao.webp" alt="Van de carga / furgão" loading="lazy" />
        </a>
