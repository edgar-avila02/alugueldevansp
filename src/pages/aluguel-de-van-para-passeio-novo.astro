---
import Base from '../layouts/Base.astro';
import { getButtonHrefForPage } from '../lib/whatsapp-links.js';

const page = {
  path: '/aluguel-de-van-para-passeio-novo/',
  title: 'Aluguel de Van para Passeio em SP com Motorista | Frota Executiva',
  description: 'Alugue vans executivas novas para passeios, viagens, praia e eventos em São Paulo. Ar-condicionado, poltronas reclináveis, Wi-Fi e motorista profissional. Faça sua cotação rápida!',
  robots: 'noindex, nofollow',
  canonical: 'https://alugueldevansp.com/aluguel-de-van-para-passeio/',
  og: [
    ['og:locale', 'pt_BR'],
    ['og:type', 'website'],
    ['og:title', 'Aluguel de Van para Passeio em SP com Motorista | Frota Executiva'],
    ['og:description', 'Nada de perrengue na estrada! Vans confortáveis e seguras para passeios inesquecíveis em SP.'],
    ['og:url', 'https://alugueldevansp.com/aluguel-de-van-para-passeio-novo/'],
    ['og:site_name', 'aluguel de van sp'],
    ['og:image', 'https://alugueldevansp.com/wp-content/uploads/2025/07/Jovens-ao-redor-de-uma-van-1024x683.webp'],
  ] as [string, string][],
  twitter: [
    ['twitter:card', 'summary_large_image'],
    ['twitter:title', 'Aluguel de Van para Passeio em SP'],
    ['twitter:description', 'Vans executivas com motorista para turismo, praia, interior e confraternizações.'],
  ] as [string, string][],
  jsonld: [],
};

const whatsappHref = getButtonHrefForPage('/aluguel-de-van-para-passeio/');
---

<Base page={page}>
  <!-- Banner Informativo de Prévia de UX -->
  <aside class="preview-bar" aria-label="Aviso de versão prévia">
    <div class="preview-bar-inner">
      <div class="preview-badge">✨ NOVO LAYOUT UX</div>
      <p>
        Esta é uma <strong>página de teste apartada</strong> focada em conversão e experiência do usuário.
        <a href="/aluguel-de-van-para-passeio/" target="_blank" rel="noopener">Comparar com a versão original ↗</a>
      </p>
    </div>
  </aside>

  <div class="service-page-wrapper">
    <!-- HERO SECTION PREMIUM -->
    <header class="hero-passeio">
      <div class="hero-container">
        <div class="hero-content">
          <div class="hero-tag">
            <span class="pulse-dot"></span>
            <span>Turismo, Lazer e Viagens em Família ou Amigos</span>
          </div>

          <h1 class="hero-headline">
            Aluguel de Van para Passeio em SP:
            <span class="gradient-text">Conforto, Diversão e Segurança</span> do Início ao Fim
          </h1>

          <p class="hero-lead">
            Elimine o cansaço de dirigir vários carros, os pedágios duplicados e a preocupação com o trânsito.
            Reúna todo o grupo em veículos executivos com <strong>ar-condicionado digital</strong>,
            <strong>poltronas reclináveis soft</strong> e <strong>motoristas profissionais dedicados</strong> ao seu roteiro.
          </p>

          <ul class="hero-checklist">
            <li>
              <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>Vans novas homologadas (ANTT, EMTU e SPTrans)</span>
            </li>
            <li>
              <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>Motoristas experientes e pontuais</span>
            </li>
            <li>
              <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>Embarque no seu endereço e paradas livres</span>
            </li>
            <li>
              <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>Seguro completo para todos os ocupantes</span>
            </li>
          </ul>

          <div class="hero-actions">
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-wa-hero">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>Solicitar Orçamento no WhatsApp</span>
            </a>
            <a href="#formulario" class="btn-secondary-hero">
              <span>Formulário Rápido</span>
            </a>
          </div>

          <div class="hero-social-proof">
            <div class="stars-gold">★★★★★</div>
            <span><strong>4.9/5 estrelas</strong> baseado em +1.500 viagens realizadas</span>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-card-media">
            <img
              src="/wp-content/uploads/2025/07/Jovens-ao-redor-de-uma-van-1024x683.webp"
              alt="Grupo de amigos e familiares aproveitando passeio de van em São Paulo"
              width="600"
              height="400"
              class="hero-img-main"
              loading="eager"
            />
            <div class="floating-badge badge-top">
              <span class="icon-sparkle">✨</span>
              <div>
                <strong>Frota Executiva 2024/2025</strong>
                <small>Mercedes Sprinter & Renault Master</small>
              </div>
            </div>
            <div class="floating-badge badge-bottom">
              <span class="icon-driver">👨‍✈️</span>
              <div>
                <strong>Motorista Dedicado</strong>
                <small>Descanso total para o grupo</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- TRUST BAR: PILARES RÁPIDOS -->
    <section class="trust-bar-section">
      <div class="content-container">
        <div class="trust-grid">
          <div class="trust-item">
            <div class="trust-icon">❄️</div>
            <div>
              <h3>Climatização Total</h3>
              <p>Ar-condicionado potente dianteiro e traseiro para toda a van.</p>
            </div>
          </div>
          <div class="trust-item">
            <div class="trust-icon">💺</div>
            <div>
              <h3>Poltronas Soft</h3>
              <p>Bancos individuais e reclináveis para descansar durante o trajeto.</p>
            </div>
          </div>
          <div class="trust-item">
            <div class="trust-icon">💰</div>
            <div>
              <h3>Economia em Grupo</h3>
              <p>Dividir o valor sai muito mais em conta do que 3 ou 4 carros.</p>
            </div>
          </div>
          <div class="trust-item">
            <div class="trust-icon">⏱️</div>
            <div>
              <h3>Pontualidade Britânica</h3>
              <p>Embarque no horário exato e retorno sem preocupações.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SEÇÃO: POR QUE ESCOLHER O ALUGUEL DE VAN SP (CONTEÚDO ORIGINAL APRIMORADO) -->
    <section class="benefits-section">
      <div class="content-container">
        <div class="section-header-centered">
          <span class="section-kicker">Vantagens Exclusivas</span>
          <h2>Razões pelas quais os viajantes escolhem nossas vans</h2>
          <p class="section-lead">
            Quem viaja em grupo sabe que logística pode ser estressante. Nós transformamos o deslocamento na melhor parte do seu passeio.
          </p>
        </div>

        <div class="benefit-cards-grid">
          <article class="benefit-card">
            <div class="card-icon-bubble">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"></path><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
            </div>
            <h3>Mais Conforto e Bem-Estar</h3>
            <p>
              Poltronas acolchoadas, ar-condicionado potente, tomadas USB e amplo espaço interno. Todos viajam descansados e chegam com energia total para curtir as atrações.
            </p>
            <ul class="mini-feature-list">
              <li>Bancos reclináveis individuais</li>
              <li>Isolamento acústico superior</li>
              <li>Som ambiente e entretenimento</li>
            </ul>
          </article>

          <article class="benefit-card highlight-card">
            <div class="card-icon-bubble">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <h3>Economia Real para o Grupo</h3>
            <p>
              Em vez de pagar gasolina, estacionamento em locais turísticos e pedágios repetidos para vários carros, a divisão do custo da van torna a viagem muito mais barata por pessoa.
            </p>
            <ul class="mini-feature-list">
              <li>Custo dividido por assento</li>
              <li>Sem gastos com motoristas de app ou táxis</li>
              <li>Sem tarifas de estacionamentos múltiplos</li>
            </ul>
          </article>

          <article class="benefit-card">
            <div class="card-icon-bubble">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <h3>Mais Organização e União</h3>
            <p>
              Embarque e desembarque integrados para manter todos os passageiros juntos. A viagem começa já na saída de São Paulo com risadas, conversa e integração.
            </p>
            <ul class="mini-feature-list">
              <li>Ninguém se perde pelo caminho</li>
              <li>Pontos de parada decididos em conjunto</li>
              <li>Horários sincronizados de chegada e volta</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- FROTA DE VANS: ESCOLHA O TAMANHO IDEAL -->
    <section class="fleet-section">
      <div class="content-container">
        <div class="section-header-centered">
          <span class="section-kicker">Modelos Disponíveis</span>
          <h2>Escolha a van perfeita para o seu grupo</h2>
          <p class="section-lead">
            Veículos novos, vistoriados constantemente, com higienização completa antes de cada viagem.
          </p>
        </div>

        <div class="fleet-grid">
          <!-- Modelo 1 -->
          <div class="fleet-card">
            <div class="fleet-img-wrapper">
              <img
                src="/wp-content/uploads/2025/07/Van-Mercedes-Benz-branca.webp"
                alt="Van Mercedes-Benz Sprinter Executiva Branca"
                width="400"
                height="260"
                loading="lazy"
              />
              <span class="fleet-pill">Mais Procurada</span>
            </div>
            <div class="fleet-body">
              <div class="fleet-header">
                <h3>Mercedes-Benz Sprinter</h3>
                <span class="fleet-cap">15 a 18 lugares</span>
              </div>
              <p class="fleet-desc">
                O padrão ouro em transporte executivo. Máximo conforto e espaço para viagens de média e longa distância.
              </p>
              <ul class="fleet-specs">
                <li><span>💺</span> Bancos individuais reclináveis</li>
                <li><span>❄️</span> Ar-condicionado digital duplo</li>
                <li><span>🧳</span> Bagageiro extra espaçoso</li>
                <li><span>🔌</span> Tomadas e entradas USB</li>
              </ul>
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-fleet">
                Cotar Este Modelo
              </a>
            </div>
          </div>

          <!-- Modelo 2 -->
          <div class="fleet-card">
            <div class="fleet-img-wrapper">
              <img
                src="/wp-content/uploads/2025/07/Van-Renault-Master-15-lugares.webp"
                alt="Van Renault Master 15 lugares"
                width="400"
                height="260"
                loading="lazy"
              />
              <span class="fleet-pill fleet-pill--amber">Melhor Custo-Benefício</span>
            </div>
            <div class="fleet-body">
              <div class="fleet-header">
                <h3>Renault Master Confort</h3>
                <span class="fleet-cap">15 lugares</span>
              </div>
              <p class="fleet-desc">
                Versatilidade e economia para passeios de um dia (bate-volta), confraternizações e praia.
              </p>
              <ul class="fleet-specs">
                <li><span>💺</span> Poltronas soft reclináveis</li>
                <li><span>❄️</span> Ar-condicionado eficiente</li>
                <li><span>🧳</span> Espaço para malas e coolers</li>
                <li><span>🎵</span> Sistema de som multimídia</li>
              </ul>
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-fleet">
                Cotar Este Modelo
              </a>
            </div>
          </div>

          <!-- Modelo 3 -->
          <div class="fleet-card">
            <div class="fleet-img-wrapper">
              <img
                src="/wp-content/uploads/2025/07/Mercedes-Benz-Minivan-prata.webp"
                alt="Mini Van Executiva Prata"
                width="400"
                height="260"
                loading="lazy"
              />
              <span class="fleet-pill fleet-pill--blue">Pequenos Grupos</span>
            </div>
            <div class="fleet-body">
              <div class="fleet-header">
                <h3>Mini Van Executiva</h3>
                <span class="fleet-cap">7 lugares</span>
              </div>
              <p class="fleet-desc">
                Perfeita para famílias pequenas, passeios gastronômicos e city tour com privacidade e agilidade.
              </p>
              <ul class="fleet-specs">
                <li><span>💺</span> Assentos ergonômicos</li>
                <li><span>❄️</span> Climatização inteligente</li>
                <li><span>🛣️</span> Agilidade no trânsito urbano</li>
                <li><span>🛡️</span> Conforto tipo sedan de luxo</li>
              </ul>
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-fleet">
                Cotar Este Modelo
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DICAS ESSENCIAIS PARA O SEU PASSEIO (CONTEÚDO ORIGINAL) -->
    <section class="tips-section">
      <div class="content-container">
        <div class="section-header-centered">
          <span class="section-kicker">Guia do Viajante</span>
          <h2>As melhores dicas para planejar o aluguel da sua van</h2>
          <p class="section-lead">
            Orientações práticas para garantir que sua experiência seja perfeita da contratação ao retorno.
          </p>
        </div>

        <div class="tips-grid">
          <div class="tip-card">
            <div class="tip-number">01</div>
            <h3>Avalie o espaço para bagagens e conforto</h3>
            <p>
              Em viagens para praia ou sítio com pernoite, leve em conta o volume de malas, mochilas e caixas térmicas. Nossas vans contam com bagageiros dedicados para que ninguém viaje apertado.
            </p>
          </div>

          <div class="tip-card">
            <div class="tip-number">02</div>
            <h3>Aproveite a vantagem do motorista incluso</h3>
            <p>
              Viajar sem se preocupar com radares, trânsito pesado de serra ou legislação de trânsito é o maior luxo. Motoristas credenciados conhecem os melhores horários e desvios seguros.
            </p>
          </div>

          <div class="tip-card">
            <div class="tip-number">03</div>
            <h3>Defina o tipo de passeio e número exato</h3>
            <p>
              Passeio turístico, praia, interior ou evento noturno? Saber a quantidade exata de passageiros ajuda a selecionar o modelo ideal (7, 15 ou 18 lugares) otimizando o investimento do grupo.
            </p>
          </div>
        </div>

        <div class="cta-inline-box">
          <div class="cta-inline-content">
            <h3>Quer ajuda para escolher o modelo ideal?</h3>
            <p>Fale diretamente com nossa equipe no WhatsApp e receba uma cotação personalizada sem compromisso.</p>
          </div>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-whatsapp-cta">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            <span>Falar com Especialista Agora</span>
          </a>
        </div>
      </div>
    </section>

    <!-- DESTINOS MAIS PROCURADOS -->
    <section class="destinations-section">
      <div class="content-container">
        <div class="section-header-centered">
          <span class="section-kicker">Inspiração de Roteiros</span>
          <h2>Destinos de passeio mais populares saindo de São Paulo</h2>
          <p class="section-lead">Atendemos viagens de bate-volta, fins de semana ou temporadas completas.</p>
        </div>

        <div class="destinations-grid">
          <div class="dest-card">
            <span class="dest-emoji">🏖️</span>
            <h3>Litoral Norte & Sul</h3>
            <p>Guarujá, Santos, Maresias, Ubatuba, Ilhabela e Bertioga com todo conforto na serra.</p>
          </div>
          <div class="dest-card">
            <span class="dest-emoji">🍷</span>
            <h3>Serra & Gastronomia</h3>
            <p>Campos do Jordão, Rota do Vinho em São Roque, Holambra e Serra Negra.</p>
          </div>
          <div class="dest-card">
            <span class="dest-emoji">🎢</span>
            <h3>Parques & Lazer</h3>
            <p>Hopi Hari, Wet'n Wild, Thermas dos Laranjais, zoológicos e parques aquáticos.</p>
          </div>
          <div class="dest-card">
            <span class="dest-emoji">🏙️</span>
            <h3>City Tour em SP</h3>
            <p>Avenida Paulista, Centro Histórico, Parque Ibirapuera, feiras e roteiros gastronômicos.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- DEPOIMENTOS DE CLIENTES -->
    <section class="testimonials-modern">
      <div class="content-container">
        <div class="section-header-centered">
          <span class="section-kicker">Depoimentos Reais</span>
          <h2>O que nossos clientes dizem sobre suas viagens</h2>
          <p class="section-lead">Mais de 1.500 viagens realizadas com nota máxima em pontualidade e cordialidade.</p>
        </div>

        <div class="testimonials-cards">
          <div class="testi-card">
            <div class="testi-stars">★★★★★</div>
            <p class="testi-quote">
