---
import Base from '../layouts/Base.astro';
import { getButtonHrefForPage } from '../lib/whatsapp-links.js';

const page = {
  path: '/aluguel-de-van-para-passeio-novo-1/',
  title: 'Aluguel de Van para Passeio em SP | Opção 2 - Experiência VIP',
  description: 'Descubra a nova experiência em aluguel de vans executivas para passeios, viagens e eventos em São Paulo. Veículos de luxo, motorista dedicado e conforto absoluto.',
  robots: 'noindex, nofollow',
  canonical: 'https://alugueldevansp.com/aluguel-de-van-para-passeio/',
  og: [
    ['og:locale', 'pt_BR'],
    ['og:type', 'website'],
    ['og:title', 'Aluguel de Van para Passeio em SP | Opção 2 - VIP'],
    ['og:description', 'Sua viagem em grupo com nível de primeira classe em São Paulo.'],
    ['og:url', 'https://alugueldevansp.com/aluguel-de-van-para-passeio-novo-1/'],
    ['og:site_name', 'aluguel de van sp'],
    ['og:image', 'https://alugueldevansp.com/wp-content/uploads/2025/07/Pessoas-felizes-dentro-da-van-1024x683.webp'],
  ] as [string, string][],
  twitter: [
    ['twitter:card', 'summary_large_image'],
    ['twitter:title', 'Aluguel de Van para Passeio em SP | Opção 2'],
    ['twitter:description', 'Vans executivas de luxo para turismo e passeios em família ou amigos.'],
  ] as [string, string][],
  jsonld: [],
};

const whatsappHref = getButtonHrefForPage('/aluguel-de-van-para-passeio/');
---

<Base page={page}>
  <!-- Top Switcher Bar para Comparação -->
  <aside class="concept-bar">
    <div class="concept-bar-inner">
      <div class="concept-pill">OPÇÃO 2: EXPERIÊNCIA VIP & LUXO</div>
      <p>
        Compare as opções disponíveis:
        <a href="/aluguel-de-van-para-passeio-novo/">Ver Opção 1 (Clean Executiva)</a> |
        <a href="/aluguel-de-van-para-passeio/" target="_blank" rel="noopener">Ver Versão Original</a>
      </p>
    </div>
  </aside>

  <div class="page-vip">
    <!-- HERO IMERSIVO DARK & LUXO -->
    <header class="vip-hero">
      <div class="vip-hero-glow"></div>
      <div class="container-vip">
        <div class="hero-split">
          <div class="hero-text-block">
            <div class="vip-eyebrow">
              <span class="sparkle-gold">★</span>
              <span>Turismo Exclusivo em São Paulo</span>
            </div>

            <h1 class="hero-vip-title">
              Sua Viagem em Família ou Amigos Merece <span class="gold-text">Primeira Classe</span>.
            </h1>

            <p class="hero-vip-subtitle">
              Chega de estresse na estrada, trânsito pesado e cansaço ao volante. Alugue vans executivas com motorista e desfrute de <strong>poltronas reclináveis soft</strong>, <strong>ar-condicionado digital</strong> e <strong>espaço de sobra para as malas</strong>.
            </p>

            <!-- Comparativo Rápido no Hero -->
            <div class="hero-quick-perks">
              <div class="quick-perk-item">
                <span class="perk-badge-num">1</span>
                <div>
                  <strong>Motorista Credenciado</strong>
                  <small>Você e seus convidados só relaxam</small>
                </div>
              </div>
              <div class="quick-perk-item">
                <span class="perk-badge-num">2</span>
                <div>
                  <strong>Todo Mundo Junto</strong>
                  <small>A diversão começa no embarque</small>
                </div>
              </div>
              <div class="quick-perk-item">
                <span class="perk-badge-num">3</span>
                <div>
                  <strong>Economia de até 40%</strong>
                  <small>Mais barato que dividir vários carros</small>
                </div>
              </div>
            </div>

            <div class="hero-cta-group">
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-gold-wa">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>Cotar Agora no WhatsApp</span>
              </a>
              <a href="#cotacao-vip" class="btn-glass">
                <span>Simular Orçamento Online</span>
              </a>
            </div>

            <div class="vip-trust-footer">
              <span class="stars-stars">★★★★★</span>
              <span><strong>4.9 / 5</strong> na avaliação dos passageiros (+1.500 viagens realizadas)</span>
            </div>
          </div>

          <!-- CARD SIMULADOR FLUTUANTE DE COTAÇÃO RÁPIDA -->
          <div class="hero-booking-card">
            <div class="booking-card-top">
              <span class="card-status-dot"></span>
              <h3>Cotação Instantânea de Passeio</h3>
              <p>Receba a proposta em menos de 5 minutos</p>
            </div>

            <form class="booking-mini-form" data-lead novalidate>
              <div class="input-floating-group">
                <label>
                  <span>Destino do Passeio</span>
                  <input type="text" name="Destino" placeholder="Ex: Litoral, Campos do Jordão, Sítio..." required />
                </label>
              </div>

              <div class="form-row-2">
                <label>
                  <span>Data da Viagem</span>
                  <input type="text" name="Data" placeholder="Ex: Próximo sábado" />
                </label>
                <label>
                  <span>Nº de Pessoas</span>
                  <select name="Passageiros">
                    <option value="Até 7">Até 7 passageiros</option>
                    <option value="8 a 15" selected>8 a 15 passageiros</option>
                    <option value="16 a 20">16 a 20 passageiros</option>
                    <option value="+20">+20 passageiros</option>
                  </select>
                </label>
              </div>

              <div class="input-floating-group">
                <label>
                  <span>Seu WhatsApp</span>
                  <input type="tel" name="Telefone" placeholder="(11) 90000-0000" required />
                </label>
              </div>

              <div class="input-floating-group">
                <label>
                  <span>Seu Nome</span>
                  <input type="text" name="Nome" placeholder="Seu nome completo" required />
                </label>
              </div>

              <!-- Anti spam -->
              <label class="lead-hp" aria-hidden="true">Não preencha<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>

              <button type="submit" class="btn-submit-vip">
                <span>Calcular Valor com Especialista</span>
                <span>→</span>
              </button>

              <p class="lead-status" role="status" aria-live="polite"></p>
              <small class="card-guarantee">🛡️ Sem compromisso e resposta em poucos minutos.</small>
            </form>
          </div>
        </div>
      </div>
    </header>

    <!-- BARRA DE CERTIFICAÇÕES E ÓRGÃOS REGULADORES -->
    <section class="cert-bar">
      <div class="container-vip">
        <div class="cert-flex">
          <div class="cert-item">
            <span class="cert-icon">🛡️</span>
            <div>
              <strong>Seguro APP Total</strong>
              <small>Cobertura para todos os passageiros</small>
            </div>
          </div>
          <div class="cert-item">
            <span class="cert-icon">📋</span>
            <div>
              <strong>Regulamentação Oficial</strong>
              <small>Homologado por ANTT, EMTU e SPTrans</small>
            </div>
          </div>
          <div class="cert-item">
            <span class="cert-icon">✨</span>
            <div>
              <strong>Frota 100% Revisada</strong>
              <small>Veículos novos, higienizados e vistoriados</small>
            </div>
          </div>
          <div class="cert-item">
            <span class="cert-icon">⏱️</span>
            <div>
              <strong>Embarque VIP no seu Local</strong>
              <small>Sem necessidade de ir até pontos centrais</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- EXPERIÊNCIA: POR TIPO DE PASSEIO (CARDS VISUAIS) -->
    <section class="experiences-section">
      <div class="container-vip">
        <div class="section-heading-dark">
          <span class="kicker-gold">Roteiros Sob Medida</span>
          <h2>Qual é o estilo do seu próximo passeio?</h2>
          <p>Temos a configuração perfeita para cada tipo de viagem em grupo.</p>
        </div>

        <div class="experiences-grid">
          <!-- Card 1 -->
          <article class="exp-card">
            <div class="exp-img-box">
              <img
                src="/wp-content/uploads/2025/07/Pessoas-felizes-dentro-da-van-1024x683.webp"
                alt="Família aproveitando viagem confortável na van"
                width="380"
                height="240"
                loading="lazy"
              />
              <span class="exp-tag">Família & Crianças</span>
            </div>
            <div class="exp-body">
              <h3>Passeio em Família</h3>
              <p>
                Tranquilidade total para crianças, pais e idosos. Poltronas macias, paradas flexíveis para lanche ou banheiro, e ar-condicionado na temperatura perfeita.
              </p>
              <ul class="exp-bullets">
                <li>Espaço para carrinhos e malas</li>
                <li>Motoristas gentis e pacientes</li>
                <li>Embarque na porta da sua casa</li>
              </ul>
            </div>
          </article>

          <!-- Card 2 -->
          <article class="exp-card">
            <div class="exp-img-box">
              <img
                src="/wp-content/uploads/2025/07/Jovens-ao-redor-de-uma-van-1024x683.webp"
                alt="Amigos viajando de van para a praia"
                width="380"
                height="240"
                loading="lazy"
              />
              <span class="exp-tag">Amigos & Lazer</span>
            </div>
            <div class="exp-body">
              <h3>Praia & Finais de Semana</h3>
              <p>
                A galera reunida do início ao fim com som ambiente e integração. Todo mundo curte o dia de sol sem ninguém precisar ficar sóbrio para dirigir na serra.
              </p>
              <ul class="exp-bullets">
                <li>Bagageiro para pranchas e coolers</li>
                <li>Zero preocupação com Lei Seca</li>
                <li>Retorno seguro após o pôr do sol</li>
              </ul>
            </div>
          </article>

          <!-- Card 3 -->
          <article class="exp-card">
            <div class="exp-img-box">
              <img
                src="/wp-content/uploads/2025/07/Van-Sprinter-prata.webp"
                alt="Van executiva para turismo e gastronomia"
                width="380"
                height="240"
                loading="lazy"
              />
              <span class="exp-tag">Gastronomia & Turismo</span>
            </div>
            <div class="exp-body">
              <h3>Rota do Vinho & Serra</h3>
              <p>
                Visite vinícolas em São Roque, desfrute da gastronomia de Campos do Jordão ou o charme de Holambra com um motorista que conhece os melhores acessos.
              </p>
              <ul class="exp-bullets">
                <li>Degustação livre sem risco de volante</li>
                <li>Tempo de espera incluso nos restaurantes</li>
                <li>Passeio sem pressa e no seu ritmo</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- COMPARATIVO: 1 VAN vs 4 CARROS (INFOGRÁFICO DE CONVERSÃO) -->
    <section class="vs-section">
      <div class="container-vip">
        <div class="vs-box">
          <div class="vs-col vs-bad">
            <div class="vs-header">
              <span class="vs-cross">✕</span>
              <h3>Viajar em 3 ou 4 Carros</h3>
            </div>
            <ul>
              <li>⛽ Gasolina e pedágios multiplicados por 4</li>
              <li>🅿️ Múltiplas taxas de estacionamento</li>
              <li>😫 4 pessoas cansadas e estressadas no trânsito</li>
              <li>🚗 Grupo separado e risco de se perder</li>
              <li>🚫 Quem dirige não pode beber nem relaxar</li>
            </ul>
          </div>

          <div class="vs-divider">
            <span>VS</span>
          </div>

          <div class="vs-col vs-good">
            <div class="vs-header">
              <span class="vs-check">✓</span>
              <h3>1 Van Executiva com Motorista</h3>
            </div>
            <ul>
              <li>💰 Custo único dividido entre todos (muito mais barato)</li>
              <li>🎉 Todo mundo junto rindo e conversando desde a partida</li>
              <li>💆 Motorista profissional assume todo o trânsito</li>
              <li>💺 Poltronas reclináveis e ar gelando o tempo todo</li>
              <li>🥂 Liberdade total para curtir as atrações sem estresse</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- NOSSA FROTA VIP: ESCOLHA INTERATIVA -->
    <section class="fleet-vip-section">
      <div class="container-vip">
        <div class="section-heading-dark">
          <span class="kicker-gold">Nossa Frota</span>
          <h2>Conheça os veículos disponíveis para seu passeio</h2>
          <p>Modelos novos, higienizados e equipados com tudo que você precisa.</p>
        </div>

        <div class="fleet-vip-cards">
          <!-- Veículo 1 -->
          <div class="vip-vehicle-card featured-vehicle">
            <div class="vehicle-badge-highlight">Mais Confortável</div>
            <div class="vehicle-img-area">
              <img
                src="/wp-content/uploads/2025/07/Van-Mercedes-Benz-branca.webp"
                alt="Mercedes-Benz Sprinter Executiva Branca"
                width="450"
                height="280"
                loading="lazy"
              />
            </div>
            <div class="vehicle-info-area">
              <div class="vehicle-title-row">
                <h3>Mercedes-Benz Sprinter Executiva</h3>
                <span class="capacity-pill">15 a 18 lugares</span>
              </div>
              <p class="vehicle-short-desc">
                O veículo mais procurado para viagens em família e eventos. Conforto inigualável em percursos de curta e longa distância.
              </p>
              <div class="vehicle-features-chips">
                <span>💺 Bancos Soft Reclináveis</span>
                <span>❄️ Ar Duplo Digital</span>
                <span>🔌 Tomadas USB</span>
                <span>🧳 Bagageiro Extra Grande</span>
                <span>🎵 Som Multimídia</span>
                <span>🛡️ Vidros Escurecidos</span>
              </div>
              <div class="vehicle-card-action">
                <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-gold-wa full-width">
                  Cotar Mercedes Sprinter no WhatsApp
                </a>
              </div>
            </div>
          </div>

          <!-- Veículo 2 -->
          <div class="vip-vehicle-card">
            <div class="vehicle-img-area">
              <img
                src="/wp-content/uploads/2025/07/Van-Renault-Master-15-lugares.webp"
                alt="Renault Master Confort 15 Lugares"
                width="450"
                height="280"
                loading="lazy"
              />
            </div>
            <div class="vehicle-info-area">
              <div class="vehicle-title-row">
                <h3>Renault Master Confort</h3>
                <span class="capacity-pill">15 lugares</span>
              </div>
              <p class="vehicle-short-desc">
                Perfeita para passeios bate-volta, parques temáticos e praias com ótimo custo-benefício e espaço interno amplo.
              </p>
              <div class="vehicle-features-chips">
                <span>💺 Poltronas Confortáveis</span>
                <span>❄️ Climatização Eficiente</span>
                <span>🧳 Amplo Porta-Malas</span>
                <span>🛡️ Revisões Rigorosas</span>
              </div>
              <div class="vehicle-card-action">
                <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-outline-gold full-width">
                  Cotar Renault Master no WhatsApp
                </a>
              </div>
            </div>
          </div>

          <!-- Veículo 3 -->
          <div class="vip-vehicle-card">
            <div class="vehicle-img-area">
              <img
                src="/wp-content/uploads/2025/07/Mercedes-Benz-Minivan-prata.webp"
                alt="Mini Van Executiva 7 Lugares"
                width="450"
                height="280"
                loading="lazy"
              />
            </div>
            <div class="vehicle-info-area">
              <div class="vehicle-title-row">
                <h3>Mini Van Executiva Especial</h3>
                <span class="capacity-pill">7 lugares</span>
              </div>
              <p class="vehicle-short-desc">
                Ideal para grupos menores que desejam privacidade absoluta, rapidez de locomoção e facilidade de acesso urbano.
              </p>
              <div class="vehicle-features-chips">
                <span>💺 Conforto de Carro de Luxo</span>
                <span>❄️ Ar-condicionado Individual</span>
                <span>🏙️ Agilidade no Trânsito</span>
                <span>🛡️ Discrição e Segurança</span>
              </div>
              <div class="vehicle-card-action">
                <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-outline-gold full-width">
                  Cotar Mini Van no WhatsApp
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DICAS ESSENCIAIS REESTRUTURADAS (CARD STORYLINE) -->
    <section class="tips-vip-section">
      <div class="container-vip">
        <div class="section-heading-dark">
          <span class="kicker-gold">Orientações de Especialistas</span>
          <h2>Dicas de ouro para o sucesso do seu passeio</h2>
          <p>O que você deve saber antes de alugar uma van para viagens.</p>
        </div>

        <div class="tips-vip-row">
          <div class="tip-vip-card">
            <div class="tip-vip-badge">Dica 1</div>
            <h3>Espaço para Malas & Bagagens</h3>
            <p>
              Ao planejar o passeio, calcule não apenas o número de assentos, mas o volume de bolsas, malas e isopores. Nossas vans contam com bagageiros sob medida para que nada viaje solto no corredor.
            </p>
          </div>

          <div class="tip-vip-card">
            <div class="tip-vip-badge">Dica 2</div>
            <h3>O Conforto do Motorista Dedicado</h3>
            <p>
              Contratar a van com motorista profissional é a garantia de que ninguém do seu grupo ficará sobrecarregado com trânsito, curvas de serra ou estacionamentos lotados.
            </p>
          </div>

          <div class="tip-vip-card">
            <div class="tip-vip-badge">Dica 3</div>
            <h3>Capacidade Certa para Economizar</h3>
            <p>
              Definir previamente se o grupo tem 7, 12, 15 ou 18 passageiros permite escolher o modelo exato, dividindo o valor com precisão e pagando o menor valor por assento.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- COMO FUNCIONA (PASSO A PASSO TRANSPARENTE) -->
    <section class="steps-section">
      <div class="container-vip">
        <div class="section-heading-dark">
          <span class="kicker-gold">Processo Simples</span>
          <h2>Como alugar sua van em 3 passos sem burocracia</h2>
        </div>

        <div class="steps-grid">
          <div class="step-card">
            <div class="step-circle">1</div>
            <h3>Envie seu Roteiro</h3>
            <p>Informe pelo WhatsApp ou formulário: data, destino, horário e quantidade de passageiros.</p>
          </div>
          <div class="step-card">
            <div class="step-circle">2</div>
            <h3>Receba a Proposta</h3>
            <p>Enviamos em minutos o orçamento detalhado com o modelo de van ideal e todos os itens inclusos.</p>
          </div>
          <div class="step-card">
            <div class="step-circle">3</div>
            <h3>Embarque e Curta</h3>
            <p>A van chega pontualmente no endereço combinado. É só entrar, relaxar e aproveitar cada quilômetro!</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FORMULÁRIO COMPLETO & DADOS OFICIAIS -->
    <section id="cotacao-vip" class="form-vip-section">
      <div class="container-vip">
        <div class="form-vip-container">
          <div class="form-vip-intro">
            <span class="kicker-gold">Atendimento Imediato</span>
            <h2>Solicite seu orçamento para o passeio</h2>
            <p>
              Conte-nos os detalhes da sua viagem e receba uma cotação sob medida sem compromisso.
            </p>

            <div class="contact-box-vip">
              <div class="contact-line">
                <span class="c-icon">📍</span>
                <div>
                  <strong>Endereço da Sede</strong>
                  <p>Av. Magalhães de Castro, 12.000 – Cidade Jardim, São Paulo – SP</p>
                </div>
              </div>
              <div class="contact-line">
                <span class="c-icon">📱</span>
                <div>
                  <strong>WhatsApp & Central</strong>
                  <p>(11) 97541-3120</p>
                </div>
              </div>
              <div class="contact-line">
                <span class="c-icon">✉️</span>
                <div>
                  <strong>E-mail</strong>
                  <p>contato@alugueldevansp.com</p>
                </div>
              </div>
            </div>

            <div class="wa-direct-banner">
              <p>Quer fechar hoje com desconto de antecedência?</p>
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-gold-wa">
                Falar com Consultor no WhatsApp
              </a>
            </div>
          </div>

          <div class="form-vip-form-box">
            <form class="lead-form lead-form--vip" data-lead novalidate>
              <h3 class="form-vip-header">Formulário de Cotação</h3>
              <p class="form-vip-sub">Preencha os campos abaixo:</p>

              <div class="lead-grid">
                <label>
                  <span>Nome *</span>
